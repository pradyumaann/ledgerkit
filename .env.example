# SQLite by default. For Postgres: postgresql+psycopg://user:pass@localhost/ledgerkit
LEDGERKIT_DATABASE_URL=sqlite:///ledgerkit.db

# REST API bearer tokens. The token a caller presents decides who it is:
# the user token can post and approve, the agent token can only draft and request approval.
# If neither is set, every caller is treated as a human user (local development only).
LEDGERKIT_USER_TOKEN=
LEDGERKIT_AGENT_TOKEN=
